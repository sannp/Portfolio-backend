# Server Configuration
NODE_ENV=development
PORT=5000
SERVER_HOST=localhost

# Database Configuration
# MongoDB
DB_CONNECTION=mongodb://localhost:27017/personal
DB_DEFAULT=mongodb

# Portfolio App Database (PostgreSQL via Aiven)
PORTFOLIO_DB_HOST=localhost
PORTFOLIO_DB_PORT=5432
PORTFOLIO_DB_NAME=base_server
PORTFOLIO_DB_USER=your_username
PORTFOLIO_DB_PASS=your_password
PORTFOLIO_DB_SSL=false

# AI Service API Keys
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
TAVILY_API_KEY=your_tavily_api_key_here

# API Security (for external access)
API_SECRET=your_secret_key_here

# CORS Configuration
CORS_ORIGIN=*
CORS_CREDENTIALS=true

# Meta WhatsApp Alerting Configuration
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_RECIPIENT_PHONE=15551234567


