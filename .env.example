# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
# MongoDB
DB_CONNECTION=mongodb://localhost:27017/base-server

# Portfolio App Database (PostgreSQL via Aiven)
PORTFOLIO_DB_HOST=localhost
PORTFOLIO_DB_PORT=5432
PORTFOLIO_DB_NAME=base_server
PORTFOLIO_DB_USER=your_username
PORTFOLIO_DB_PASS=your_password
PORTFOLIO_DB_SSL=false

# Legacy fallback support (deprecated, will be removed)
# POSTGRES_HOST=${PORTFOLIO_DB_HOST}
# POSTGRES_PORT=${PORTFOLIO_DB_PORT}
# POSTGRES_DATABASE=${PORTFOLIO_DB_NAME}
# POSTGRES_USERNAME=${PORTFOLIO_DB_USER}
# POSTGRES_PASSWORD=${PORTFOLIO_DB_PASS}
# POSTGRES_SSL=${PORTFOLIO_DB_SSL}

# AI Service API Keys
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
GROK_API_KEY=your_grok_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# API Security (for external AI access)
API_SECRET=your_secret_key_here

# CORS Configuration
CORS_ORIGIN=*

# File Upload Configuration
MAX_FILE_SIZE=20000000
UPLOAD_BUCKET=uploads

# AI Research Assistant Configuration
TAVILY_API_KEY=your_tavily_api_key_here
ANALYST_MODEL=gemini-2.5-flash
FAST_MODEL=gemini-2.5-flash
MAX_REQUESTS_PER_IP=2

# n8n Workflow Automation Configuration
N8N_ENABLED=true
N8N_PORT=5678
N8N_PATH=/n8n/
N8N_PROTOCOL=https
N8N_HOST=localhost
# N8N_EDITOR_BASE_URL=https://your-domain.com/n8n/  # Optional: defaults to N8N_PROTOCOL + N8N_HOST + N8N_PATH
# WEBHOOK_URL=https://your-domain.com/n8n/webhook/  # Optional: defaults to N8N_EDITOR_BASE_URL + 'webhook/'
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your_secure_password_here
N8N_ENCRYPTION_KEY=your_32_char_encryption_key_here

# n8n Workflow Database (PostgreSQL - reuses PORTFOLIO_DB_* by default)
# Set N8N_DB_* vars only if n8n needs different DB than portfolio app
N8N_DB_NAME=n8n
# N8N_DB_HOST=${PORTFOLIO_DB_HOST}      # Optional: defaults to PORTFOLIO_DB_HOST
# N8N_DB_PORT=${PORTFOLIO_DB_PORT}      # Optional: defaults to PORTFOLIO_DB_PORT
# N8N_DB_USER=${PORTFOLIO_DB_USER}    # Optional: defaults to PORTFOLIO_DB_USER
# N8N_DB_PASS=${PORTFOLIO_DB_PASS}    # Optional: defaults to PORTFOLIO_DB_PASS
N8N_DB_SSL_ENABLED=true
N8N_DB_SSL_REJECT_UNAUTHORIZED=false
